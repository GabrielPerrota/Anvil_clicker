/* Palette */
:root {
    --color-ink: rgb(244, 232, 210);
    --color-ink-muted: rgb(176, 160, 138);
    --color-panel: rgba(28, 20, 16, 0.82);
    --color-panel-border: rgb(110, 78, 46);
    --color-gold: rgb(255, 200, 70);
    --color-ember: rgb(255, 120, 40);
    --color-crit: rgb(255, 222, 90);
    --color-track: rgba(0, 0, 0, 0.45);
}

.hud-root {
    flex-grow: 1;
    justify-content: space-between;
    padding: 24px;
    padding-right: 464px; /* room for the shop panel */
}

.panel {
    background-color: var(--color-panel);
    border-width: 2px;
    border-color: var(--color-panel-border);
    border-radius: 10px;
    padding: 12px 18px;
}

/* Top bar */
.hud-top {
    flex-direction: row;
}

.gold-panel {
    flex-direction: row;
    align-items: center;
}

.gold-icon {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: var(--color-gold);
    border-width: 2px;
    border-color: rgb(170, 110, 20);
    margin-right: 12px;
}

.gold-label {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-gold);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.caption {
    font-size: 14px;
    color: var(--color-ink-muted);
    padding: 0;
    margin: 0;
}

/* Bottom forge panel */
.hud-bottom {
    align-items: center;
}

.forge-panel {
    width: 460px;
    align-items: stretch;
}

.weapon-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-ink);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.progress-track {
    height: 18px;
    border-radius: 9px;
    background-color: var(--color-track);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    border-radius: 9px;
    background-color: var(--color-ember);
    transition-property: width;
    transition-duration: 0.08s;
}

.forge-stats {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.stat-label {
    font-size: 15px;
    color: var(--color-ink-muted);
    padding: 0;
    margin: 0;
}

.hint {
    font-size: 13px;
    color: var(--color-ink-muted);
    -unity-text-align: middle-center;
    margin-top: 6px;
    opacity: 0.7;
}

/* Floating numbers */
.floating-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.floating-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-ink);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    padding: 0;
    margin: 0;
}

.floating-text--critical {
    font-size: 40px;
    color: var(--color-crit);
}

.floating-text--reward {
    font-size: 24px;
    color: var(--color-gold);
}

/* Shop panel */
.shop-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: 416px;
    padding: 12px;
}

.shop-tabs {
    flex-direction: row;
    margin-bottom: 8px;
}

.shop-tab {
    flex-grow: 1;
    height: 36px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-ink-muted);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 6px;
    margin: 0 2px;
}

.shop-tab:hover {
    color: var(--color-ink);
}

.shop-tab--active {
    color: var(--color-ink);
    background-color: var(--color-panel-border);
}

.buy-amounts {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.buy-amounts__label {
    margin-right: 6px;
}

.buy-amount {
    height: 26px;
    min-width: 52px;
    font-size: 13px;
    color: var(--color-ink-muted);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(110, 78, 46, 0.6);
    border-radius: 5px;
    margin: 0 2px;
}

.buy-amount--active {
    color: var(--color-gold);
    border-color: var(--color-gold);
}

.shop-list {
    flex-grow: 1;
}

.shop-empty {
    -unity-text-align: middle-center;
    margin-top: 12px;
}

.shop-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 6px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.3);
}

.shop-row__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
}

.shop-row__header {
    flex-direction: row;
    align-items: center;
}

.shop-row__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-ink);
    padding: 0;
    margin: 0 6px 0 0;
}

.shop-row__level {
    font-size: 13px;
    color: var(--color-gold);
    padding: 0;
    margin: 0;
}

.shop-row__detail {
    font-size: 12px;
    color: var(--color-ink-muted);
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.shop-row__buy {
    width: 112px;
    min-height: 44px;
    border-width: 1px;
    border-color: var(--color-gold);
    border-radius: 6px;
    background-color: rgba(120, 80, 20, 0.55);
    justify-content: center;
    align-items: center;
    padding: 2px 4px;
}

.shop-row__buy:hover {
    background-color: rgba(160, 110, 30, 0.7);
}

.shop-row__buy:disabled {
    opacity: 0.45;
}

.shop-row__quantity {
    font-size: 11px;
    color: var(--color-ink-muted);
    padding: 0;
    margin: 0;
}

.shop-row__cost {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-gold);
    padding: 0;
    margin: 0;
}

/* Offline summary modal */
.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.modal {
    width: 520px;
    padding: 24px 28px;
    align-items: center;
}

.modal-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-ink);
    margin-bottom: 12px;
}

.modal-text {
    font-size: 17px;
    color: var(--color-ink);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.modal-gold {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-gold);
    margin: 10px 0;
}

.modal-note {
    margin-bottom: 12px;
}

.modal-button {
    width: 200px;
    height: 44px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-ink);
    background-color: var(--color-panel-border);
    border-width: 0;
    border-radius: 8px;
}

.modal-button:hover {
    background-color: rgb(140, 100, 60);
}

.hidden {
    display: none;
}
